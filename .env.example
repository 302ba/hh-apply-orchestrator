# === Provider switch ===
# one of: openai | openrouter | opencode-go | opencode-zen | lmstudio | ollama | llamacpp
# `opencode` is accepted as an alias for `opencode-go`.
LLM_PROVIDER=openai

# Optional: override the default model for the chosen provider
# openai      → default: gpt-4o-mini      (https://api.openai.com/v1)
# openrouter  → default: openai/gpt-4o-mini (https://openrouter.ai/api/v1)
# opencode-go → default: qwen3.8-flash   (https://opencode.ai/zen/go/v1)
# opencode-zen → default: gpt-5.6-luna   (https://opencode.ai/zen/v1)
# lmstudio    → default: local-model     (http://localhost:1234/v1)
# ollama      → default: llama3.1       (http://localhost:11434/v1)
# llamacpp    → default: local-model     (http://localhost:8080/v1)
# LLM_MODEL=gpt-4o-mini

# Override the OpenAI-compatible base URL for any provider
# LLM_BASE_URL=http://localhost:1234/v1

# === API keys ===
# Used by LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me

# Used by LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_REFERER=https://localhost
OPENROUTER_TITLE=hh-auto-apply

# Used by LLM_PROVIDER=opencode, opencode-go, or opencode-zen
OPENCODE_API_KEY=sk-oc-replace-me

# Local providers (lmstudio, ollama, llamacpp) usually do not require a real key.
# Set these only if your local server enforces authentication.
# LMSTUDIO_API_KEY=
# OLLAMA_API_KEY=
# LLAMACPP_API_KEY=

# Optional: override session storage directory
# SESSION_FILES_DIR=.session-files

# Optional exact auto-apply output file override. By default each run gets a timestamped file.
# LOG_FILE=logs/auto-apply.log

# Directory for generated cover letters. Relative paths are resolved from project root.
LETTERS_DIR=letters

# === Automation safety settings ===
# Number of search-result pages per query
HH_MAX_PAGES=1

# Delay between applications, in seconds. Keep this at 5 or higher.
HH_DELAY_BETWEEN_APPLIES_SECONDS=10

# Retries for safe page reads and LLM requests. Applications are never retried automatically.
HH_READ_RETRIES=2
LLM_RETRIES=2

# Maximum output/reasoning token budget for each cover letter request.
LLM_MAX_TOKENS=1024

# LLM generation parameters. Defaults match the recommended values for local 8B-class models.
# LLM_CONTEXT_LENGTH=16384
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=0.8
# LLM_TOP_K=20
# LLM_MIN_P=0
# LLM_REPEAT_PENALTY=1.08
# Flash attention and keep-model-loaded are recommendations for local servers
# (LM Studio / Ollama / llama.cpp apply them server-side automatically when supported).
# LLM_FLASH_ATTENTION=true
# LLM_KEEP_MODEL_LOADED=true

# Apply mode: auto (full automation) or semi (manual submit per vacancy)
# SEMI_AUTO=true

# Dry-run: scan and filter vacancies but never generate letters or submit applications
# DRY_RUN=true

# Resume mode: use config/resume.md instead of profile.md with the user's natural prompt
# RESUME_MODE=true
