# === Provider switch ===
# one of: openai | openrouter | opencode-go | opencode-zen
# `opencode` is accepted as an alias for `opencode-go`.
LLM_PROVIDER=openai

# Optional: override the default model for the chosen provider
# openai     → default: gpt-4o-mini      (https://api.openai.com/v1)
# openrouter → default: openai/gpt-4o-mini (https://openrouter.ai/api/v1)
# opencode-go → default: qwen3.8-flash   (https://opencode.ai/zen/go/v1)
# opencode-zen → default: gpt-5.6-luna   (https://opencode.ai/zen/v1)
# LLM_MODEL=gpt-4o-mini

# === API keys ===
# Used by LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me

# Used by LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_REFERER=https://localhost
OPENROUTER_TITLE=hh-auto-apply

# Used by LLM_PROVIDER=opencode, opencode-go, or opencode-zen
OPENCODE_API_KEY=sk-oc-replace-me

# Optional: override base URL (e.g. for local proxies)
# LLM_BASE_URL=

# Optional: override session storage directory
# N8N_FILES_DIR=~/.n8n-files

# Auto-apply output file. Relative paths are resolved from project root.
LOG_FILE=logs/auto-apply.log

# === Automation safety settings ===
# Number of search-result pages per query
HH_MAX_PAGES=1

# Delay between applications, in seconds. Keep this at 5 or higher.
HH_DELAY_BETWEEN_APPLIES_SECONDS=10

# Retries for safe page reads and LLM requests. Applications are never retried automatically.
HH_READ_RETRIES=2
LLM_RETRIES=2
